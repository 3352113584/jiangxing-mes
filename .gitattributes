# ============================================================
# 匠星智造 MES — 换行符与文本/二进制归类
# ============================================================
# 目的：无论开发机的 core.autocrlf / core.eol 如何设置，仓库 blob、
#       checkout 结果与 `git archive` 产物都稳定为 LF。
#
# 背景（真实故障）：开发机全局 core.autocrlf=true 时，`git archive HEAD`
#   会把 LF 还原成 CRLF 写进归档。部署到 Linux 后 shell 脚本首行变成
#   `#!/bin/sh^M`，出现 "/bin/sh^M: bad interpreter: No such file or directory"，
#   Dockerfile / nginx 配置也会被污染。
#   显式声明 `eol=lf` 可让归档与 checkout 都强制 LF，彻底消除该风险。
#
# 约定：
#   - 文本文件：一律 LF（含 Windows 上的 shell / Dockerfile / nginx / yaml / sql）
#   - 二进制文件：声明为 binary，禁止任何行尾转换，避免损坏
# ============================================================

# 默认：自动识别文本，命中的文本一律 LF；被识别为二进制的文件不受 eol 影响
* text=auto eol=lf

# ---------- 文本（显式声明，便于维护与 review） ----------
# shell / 容器入口
*.sh          text eol=lf
*.bash        text eol=lf
Dockerfile        text eol=lf
Dockerfile.*      text eol=lf
*.dockerfile  text eol=lf
Makefile      text eol=lf

# 后端 / 数据库
*.py          text eol=lf
*.pyi         text eol=lf
*.sql         text eol=lf
*.mako        text eol=lf
*.ini         text eol=lf
*.cfg         text eol=lf
*.toml        text eol=lf
*.txt         text eol=lf

# 部署编排 / 配置
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
*.json        text eol=lf
.env          text eol=lf
.env.*        text eol=lf
*.env         text eol=lf
*.example     text eol=lf

# 前端
*.html        text eol=lf
*.htm         text eol=lf
*.css         text eol=lf
*.scss        text eol=lf
*.less        text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.vue         text eol=lf

# 文档 / 数据文本
*.md          text eol=lf
*.markdown    text eol=lf
*.csv         text eol=lf

# git 自身
.gitattributes text eol=lf
.gitignore     text eol=lf

# ---------- 二进制（禁止行尾转换） ----------
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.bmp         binary
*.ico         binary
*.webp        binary
*.svg         text eol=lf
*.pdf         binary
*.zip         binary
*.gz          binary
*.tgz         binary
*.tar         binary
*.7z          binary
*.rar         binary
*.xlsx        binary
*.xls         binary
*.docx        binary
*.doc         binary
*.pptx        binary
*.apk         binary
*.aab         binary
*.db          binary
*.sqlite      binary
*.sqlite3     binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.otf         binary
*.eot         binary
*.keystore    binary
*.jks         binary
