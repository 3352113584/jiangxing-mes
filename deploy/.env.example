# ============================================================
# MES 钢结构出口加工厂 - 生产环境配置示例
# ============================================================
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填写下面的真实值（尤其密码/密钥/Token），.env 已被 .gitignore 忽略，不入库
#   3. 不要把 .env 提交到 Git
#
# 变量命名约定（统一，避免迁移/应用使用不同变量）：
#   - MES_DATABASE_URL          应用运行态连接（由 compose 按服务名注入，通常无需手填）
#   - MES_MIGRATION_DATABASE_URL 迁移/DDL 连接（与 Alembic env.py 一致）
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=jiangxing_mes
POSTGRES_USER=mes_user
# 必填：强密码，从密钥管理获取，不要写入本文件提交
POSTGRES_PASSWORD=

# ---- 应用数据库连接（最小权限角色 mes_app）----
# 容器内由 docker-compose.prod.yml 自动按服务名 postgres 注入，
# 此处仅作本地/外部调试参考（生产请保持由 compose 注入）。
MES_DATABASE_URL=postgresql+psycopg://mes_user:CHANGE_ME@postgres:5432/jiangxing_mes

# ---- 迁移/DDL 数据库连接（超级用户）----
# 变量名唯一，与 Alembic env.py 保持一致（B-3 统一命名）。
MES_MIGRATION_DATABASE_URL=postgresql+psycopg://mes_user:CHANGE_ME@postgres:5432/jiangxing_mes

# ---- Token 签名密钥（必填，生产必须覆盖）----
# 使用强随机值，例如：openssl rand -hex 32
MES_SECRET=

# Token 有效期（秒），默认 12 小时
MES_TOKEN_TTL=43200

# 调试模式（true 时 CORS 允许 *，仅开发）；生产必须为 false
MES_DEBUG=false

# ---- CORS 允许的前端 Origin（生产必填，逗号分隔，禁止 *）----
# 例：https://mes.example.com
MES_CORS_ORIGINS=

# ---- 时区（数据库与容器均为 Asia/Shanghai；T-17 依赖 CURRENT_DATE 语义）----
TZ=Asia/Shanghai

# ---- 数据库连接池（可选，默认值见 backend/Dockerfile）----
MES_DB_POOL_SIZE=10
MES_DB_MAX_OVERFLOW=20
MES_DB_POOL_RECYCLE=1800

# ---- 文件存储（预留，当前版本未启用文件上传后端）----
# none | minio | s3
MES_FILE_STORAGE_BACKEND=none
MES_FILE_STORAGE_BUCKET=
MES_FILE_STORAGE_ENDPOINT=

# ---- 首次管理员初始化（仅 init_admin.py 使用，不硬编码密码）----
# 由运维在首次部署后手动执行 deploy/scripts/init_admin.py 时从环境变量读取，
# 此文件仅声明变量名，不填写真实凭据。
MES_INIT_ADMIN_USER=
MES_INIT_ADMIN_PASSWORD=
