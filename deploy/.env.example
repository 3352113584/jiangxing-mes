# ============================================================
# MES 钢结构出口加工厂 - 开发环境配置示例
# ============================================================
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改下面的密码为本地开发密码
#   3. 不要把 .env 提交到 Git
# ============================================================

# PostgreSQL 配置
POSTGRES_DB=jiangxing_mes
POSTGRES_USER=mes_user
# 请修改为强密码（仅本地开发用，不进入 Git）
POSTGRES_PASSWORD=ChangeMe_to_Strong_Password_2026
# 本机映射端口（仅 127.0.0.1，不对外网开放）
POSTGRES_PORT=5433

